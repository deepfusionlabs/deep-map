<?xml version="1.0" encoding="utf-8"?>
<!-- Offline by construction: no package source at all. A restore resolves every package from the global packages
     folder (~/.nuget/packages, or NUGET_PACKAGES) and fails (NU1101) instead of downloading when one is missing. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <auditSources>
    <clear />
  </auditSources>
</configuration>
